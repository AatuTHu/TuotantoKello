{
  "expo": {
    "name": "TuotantoKello",
    "slug": "TuotantoKello",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "minSdkVersion": 24,
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aulis.TuotantoKello"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "803d2532-cdbc-4698-a704-c26207fc9f73"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
